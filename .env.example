# Career OpenClaw Agent — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# LLM Provider (pick one)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# LLM model for extraction and classification
LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MODEL=gpt-4o

# Optional: SerpAPI for structured job search (enables serpapi source)
# SERPAPI_KEY=...

# Optional: override default paths
# CAREER_OPENCLAW_DB_PATH=./db
# CAREER_OPENCLAW_RUNS_PATH=./runs

# ------------------------------------------------------------------
# API server (apps/api) — auth & cookies
# ------------------------------------------------------------------
# Deployment environment. Set to "production" for any multi-user deploy.
# In production the X-Dev-Context auth bypass is FORCE-disabled and session
# cookies default to Secure (HTTPS-only), regardless of the flags below.
ENV=development

# Local-dev auth bypass: when DEV_MODE=1 (and ENV is not production), requests
# carrying the header `X-Dev-Context: dev` skip cookie auth and act as the
# dev_default workspace. Defaults to 0 (OFF) so it can never leak in a deploy.
# Set to 1 for local curl / single-user dev.
DEV_MODE=1

# Force Secure flag on the session cookie. Defaults to 1 in production, 0 otherwise.
# COOKIE_SECURE=1

# Session lifetime (days).
# SESSION_TTL_DAYS=30

# Comma-separated allowed CORS origins for the web frontend.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Workspace id whose job store backs the shared, browsable job catalog. Job
# records are not user-specific, so every workspace browses this one catalog
# (a newly-invited user sees jobs immediately). Defaults to dev_default, which
# is where the search/process pipeline writes.
# CATALOG_WORKSPACE_ID=dev_default

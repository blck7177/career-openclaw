FROM python:3.12-slim

WORKDIR /app

# Install Python deps
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[worker]" 2>/dev/null || pip install --no-cache-dir -e .

# Copy source
COPY src/ ./src/
COPY apps/worker/ ./apps/worker/
COPY apps/__init__.py ./apps/
COPY configs/ ./configs/
COPY schemas/ ./schemas/

# data/ is mounted at runtime
RUN mkdir -p /app/data

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "apps.worker.worker"]

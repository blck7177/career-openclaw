#!/usr/bin/env bash
# career_query_jobs — query the job intelligence database
# Usage: ./wrappers/career_query_jobs [--workstream "Market Risk"] [--company "Goldman"] [--since 2026-06-01] [--format summary|jsonl]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.query_jobs "$@"

#!/usr/bin/env bash
# career_analyze_roles — two-layer role dossier analysis for jobs from a completed run
#
# Usage:
#   ./wrappers/career_analyze_roles --run-id <run_id>
#   ./wrappers/career_analyze_roles --run-id <run_id> --dry-run
#   ./wrappers/career_analyze_roles --run-id <run_id> --limit 5
#   ./wrappers/career_analyze_roles --run-id <run_id> --job-ids job_abc123,job_def456
#
# Prerequisites:
#   1. career_run_discovery must have completed for the run
#   2. .env must have OPENAI_API_KEY or ANTHROPIC_API_KEY
#
# Outputs (written to runs/<run_id>/):
#   role_dossier_reports/<job_id>.md   Layer 1 narrative report per job
#   role_dossiers.jsonl                Layer 2 structured dossiers
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found. Run: python -m venv .venv && pip install -e ."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.analyze_roles_cli "$@"

#!/usr/bin/env bash
# career_summarize_run — display run summary
# Usage: ./wrappers/career_summarize_run --run-id <session_id> [--format markdown|json]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.summarize_run "$@"

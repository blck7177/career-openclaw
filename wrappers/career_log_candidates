#!/usr/bin/env bash
# career_log_candidates — log triaged job candidates to the candidate pool
# Usage: ./wrappers/career_log_candidates --session-id <id> [--candidates-file <file>]
#   or:  ./wrappers/career_log_candidates --session-id <id> --url <url> --title <title> ...
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found. Run: python -m venv .venv && source .venv/bin/activate && pip install -e ."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.log_candidates_cli "$@"

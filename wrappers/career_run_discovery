#!/usr/bin/env bash
# career_run_discovery — process candidate pool through full pipeline
# Usage: ./wrappers/career_run_discovery --from-candidates runs/<id>/candidate_pool.jsonl [--dry-run] [--max-jobs N]
#
# Prerequisites:
#   1. Search session must be complete (candidate_pool.jsonl exists)
#   2. .env must have ANTHROPIC_API_KEY or OPENAI_API_KEY
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found. Run: python -m venv .venv && source .venv/bin/activate && pip install -e ."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.run_discovery "$@"

#!/usr/bin/env bash
# career_search_session — manage search session lifecycle
# Usage: ./wrappers/career_search_session <start|status|log-query|log-expansion|end> [options]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found. Run: python -m venv .venv && source .venv/bin/activate && pip install -e ."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.search_session_cli "$@"

#!/usr/bin/env bash
# career_update_strategy — persist run learnings into cross-run strategy state
# Usage: ./wrappers/career_update_strategy --run-id <id> --patch-file <path>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.update_strategy "$@"

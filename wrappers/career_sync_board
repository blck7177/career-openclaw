#!/usr/bin/env bash
# career_sync_board — sync all active jobs from a company's ATS board
#
# Usage:
#   ./wrappers/career_sync_board --source greenhouse --slug schonfeld [--session-id <id>] [--output-format json|summary]
#
# Syncs all published jobs from the company's Greenhouse/Lever/Ashby board
# and writes them as candidates to the session's candidate_pool.jsonl.
#
# Examples:
#   ./wrappers/career_sync_board --source greenhouse --slug schonfeld
#   ./wrappers/career_sync_board --source greenhouse --slug schonfeld --session-id 2026-06-10_120000 --output-format json
#   ./wrappers/career_sync_board --source lever --slug some-company --output-format summary
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found. Run: python -m venv .venv && source .venv/bin/activate && pip install -e ."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.sync_board_cli "$@"

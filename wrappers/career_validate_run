#!/usr/bin/env bash
# career_validate_run — validate run output against schema
# Usage: ./wrappers/career_validate_run --run-id <session_id> [--format json|text]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.validate_run "$@"

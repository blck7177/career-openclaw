#!/usr/bin/env bash
# career_search_status — show current session coverage statistics
# Usage: ./wrappers/career_search_status --session-id <id> [--format json|text]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$WORKSPACE_ROOT"

if [[ ! -d ".venv" ]]; then
  echo '{"error": "Python venv not found. Run: python -m venv .venv && source .venv/bin/activate && pip install -e ."}' >&2
  exit 1
fi

exec .venv/bin/python -m career_intelligence.tools.search_status_cli "$@"
